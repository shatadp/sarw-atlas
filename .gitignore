# Dependencies
node_modules/

# Vite / build output
dist/
dist-ssr/
*.local

# TypeScript incremental build cache
*.tsbuildinfo

# Local scratch — temp downloads, exploration
tmp/

# GeoJSON build cache (regenerable; the OUTPUT in public/geo/ IS committed)
data-pipeline/geo/cache/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Env / secrets (matters once the AI backend arrives)
.env
.env.*
!.env.example

# NOTE: public/data/*.json is GENERATED but intentionally COMMITTED
# (small, lets the site build without running Python). Do not ignore it.
